    "faq": {
      "type": "faq",
      "settings": {},
      "blocks": {
        "b1": {
          "type": "question",
          "settings": {
            "question": "Mon animal peut-il l’utiliser sans surveillance ?",
            "answer": "<p>Surveille les premières séances pour voir comment il joue. Retire le jouet s’il commence à le mâchouiller ou s’il est abîmé. Aucun jouet n’est indestructible.</p>"
          }
        },
        "b2": {
          "type": "question",
          "settings": {
            "question": "Quelles croquettes mettre dedans ?",
            "answer": "<p>Des croquettes sèches de petite taille, qui passent facilement par l’ouverture. La balle est petite : ne la donne pas à un grand chien, qui pourrait l’avaler.</p>"
          }
        },
        "b3": {
          "type": "question",
          "settings": {
            "question": "Comment le nettoyer ?",
            "answer": "<p>Rince la balle à l’eau tiède avec un peu de liquide vaisselle, puis laisse-la sécher.</p>"
          }
        },
        "b4": {
          "type": "question",
          "settings": {
            "question": "Quand vais-je recevoir ma commande ?",
            "answer": "<p>Ta commande est expédiée depuis notre entrepôt partenaire et livrée en 12 à 18 jours. Tu reçois un numéro de suivi par e-mail dès l’expédition.</p>"
          }
        },
        "b5": {
          "type": "question",
          "settings": {
            "question": "Puis-je retourner le produit ?",
            "answer": "<p>Oui, tu disposes de 14 jours après réception pour te rétracter, sans avoir à te justifier. Écris-nous pour obtenir l’adresse de retour.</p>"
          }
        }
