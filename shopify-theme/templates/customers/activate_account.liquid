<section class="page wrap">
  <h1 class="h1">Activer mon compte</h1>
  {%- form 'activate_customer_password', class: 'form' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="ActPassword">Mot de passe</label><input id="ActPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label for="ActConfirm">Confirmer le mot de passe</label><input id="ActConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button type="submit" class="btn btn--ink">Activer</button>
  {%- endform -%}
</section>
