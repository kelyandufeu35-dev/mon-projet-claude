<section class="page wrap">
  <h1 class="h1">{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer', class: 'form' -%}
    {{ form.errors | default_errors }}
    <div class="form__row">
      <div class="field"><label for="RegFirst">{{ 'customer.fields.first_name' | t }}</label><input id="RegFirst" type="text" name="customer[first_name]" autocomplete="given-name"></div>
      <div class="field"><label for="RegLast">{{ 'customer.fields.last_name' | t }}</label><input id="RegLast" type="text" name="customer[last_name]" autocomplete="family-name"></div>
    </div>
    <div class="field"><label for="RegEmail">{{ 'customer.fields.email' | t }}</label><input id="RegEmail" type="email" name="customer[email]" autocomplete="email" required></div>
    <div class="field"><label for="RegPassword">{{ 'customer.fields.password' | t }}</label><input id="RegPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <button type="submit" class="btn btn--ink">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
</section>
