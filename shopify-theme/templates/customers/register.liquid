<section class="page wrap">
  <h1 class="h1">Créer un compte</h1>
  {%- form 'create_customer', class: 'form' -%}
    {{ form.errors | default_errors }}
    <div class="form__row">
      <div class="field"><label for="RegFirst">Prénom</label><input id="RegFirst" type="text" name="customer[first_name]" autocomplete="given-name"></div>
      <div class="field"><label for="RegLast">Nom</label><input id="RegLast" type="text" name="customer[last_name]" autocomplete="family-name"></div>
    </div>
    <div class="field"><label for="RegEmail">E-mail</label><input id="RegEmail" type="email" name="customer[email]" autocomplete="email" required></div>
    <div class="field"><label for="RegPassword">Mot de passe</label><input id="RegPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <button type="submit" class="btn btn--ink">Créer mon compte</button>
  {%- endform -%}
</section>
