<section class="page wrap">
  <h1 class="h1">{{ 'customer.reset.title' | t }}</h1>
  {%- form 'reset_customer_password', class: 'form' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="ResetPassword">{{ 'customer.fields.password' | t }}</label><input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label for="ResetConfirm">{{ 'customer.fields.password_confirm' | t }}</label><input id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button type="submit" class="btn btn--ink">{{ 'customer.reset.submit' | t }}</button>
  {%- endform -%}
</section>
