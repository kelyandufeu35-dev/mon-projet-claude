<section class="page wrap">
  <h1 class="h1">Nouveau mot de passe</h1>
  {%- form 'reset_customer_password', class: 'form' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="ResetPassword">Mot de passe</label><input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label for="ResetConfirm">Confirmer le mot de passe</label><input id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button type="submit" class="btn btn--ink">Enregistrer</button>
  {%- endform -%}
</section>
