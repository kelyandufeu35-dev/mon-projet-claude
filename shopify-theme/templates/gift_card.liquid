{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {%- assign brand = settings.brand_name | default: shop.name -%}
    <title>{{ 'gift_card.page_title' | t: brand: brand }}</title>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="page wrap">
      <h1 class="h1">{{ 'gift_card.title' | t: brand: brand }}</h1>
      <p class="lead">{{ 'gift_card.balance' | t }} <strong>{{ gift_card.balance | money }}</strong>{% if gift_card.expired %} {{ 'gift_card.expired' | t }}{% endif %}</p>
      <p>{{ 'gift_card.code' | t }} <strong class="gift-code">{{ gift_card.code | format_code }}</strong></p>
      {%- if gift_card.pass_url -%}<p><a href="{{ gift_card.pass_url }}">{{ 'gift_card.wallet' | t }}</a></p>{%- endif -%}
      <p><a href="{{ shop.url }}" class="btn btn--ink">{{ 'gift_card.shop' | t }}</a></p>
    </main>
  </body>
</html>
