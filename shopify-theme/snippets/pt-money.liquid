{%- comment -%}
  Montant dans la devise du visiteur (cart.currency, devise du marché Shopify).
  - Euro : format français « 14,99 € » (espace insécable avant « € »), quelle que soit la langue
    et quel que soit le format monétaire de la boutique (« €14,99 » par défaut sur Shopify).
  - Autre devise (GBP, USD, CHF…) : format natif de Shopify pour cette devise (filtre money),
    espaces rendues insécables.
  Côté JS, assets/theme.js suit la même règle (Intl.NumberFormat hors euro).
  cents : montant en centimes (obligatoire).
{%- endcomment -%}
{%- liquid
  assign pt_c = cents | plus: 0
  if cart.currency.iso_code == 'EUR'
    assign pt_e = pt_c | divided_by: 100 | floor
    assign pt_d = pt_c | modulo: 100 | plus: 100 | append: '' | slice: 1, 2
    if pt_e >= 1000
      assign pt_k = pt_e | divided_by: 1000 | floor
      assign pt_r = pt_e | modulo: 1000 | plus: 1000 | append: '' | slice: 1, 3
      assign pt_e = pt_k | append: ' ' | append: pt_r
    endif
    echo pt_e | append: ',' | append: pt_d | append: '&nbsp;€'
  else
    echo pt_c | money | replace: ' ', '&nbsp;'
  endif
-%}
