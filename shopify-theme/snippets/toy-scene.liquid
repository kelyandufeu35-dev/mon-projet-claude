{%- comment -%}
  Petite scène animée de la balle à friandises (illustration décorative).
  Paramètre : scene = 'fill' (on remplit), 'drop' (on pose), 'roll' (elle roule
  et libère les croquettes) ou 'party' (version joyeuse pour l'appel à l'action).
{%- endcomment -%}
{%- assign scene = scene | default: 'party' -%}
<svg class="toy-scene toy-scene--{{ scene }}" viewBox="0 0 220 160" aria-hidden="true" focusable="false">
  <ellipse class="ts-shadow" cx="110" cy="142" rx="38" ry="6" />
  <line class="ts-floor" x1="14" y1="142" x2="206" y2="142" />

  {%- if scene == 'roll' or scene == 'party' -%}
    <g class="ts-crumbs">
      <path class="ts-kibble" d="M40 136c0-4 4-6 8-6s7 2 7 5-3 6-8 6-7-2-7-5z" />
      <path class="ts-kibble" d="M62 137c0-3 3-5 6-5s6 2 6 4-3 5-6 5-6-1-6-4z" />
      <path class="ts-kibble" d="M160 136c0-4 4-6 8-6s7 2 7 5-3 6-8 6-7-2-7-5z" />
    </g>
  {%- endif -%}

  <g class="ts-ball">
    <circle class="ts-ball__body" cx="110" cy="98" r="42" />
    <path class="ts-ball__band" d="M70 90c26 10 54 10 80 0" />
    <ellipse class="ts-ball__shine" cx="94" cy="80" rx="11" ry="7" />
    <ellipse class="ts-ball__hole" cx="110" cy="58" rx="11" ry="5" />
    <circle class="ts-ball__dot" cx="128" cy="112" r="4" />
    <circle class="ts-ball__dot" cx="92" cy="116" r="3" />
  </g>

  {%- if scene == 'fill' -%}
    <g class="ts-fall">
      <path class="ts-kibble" d="M100 8c0-4 4-6 8-6s7 2 7 5-3 6-8 6-7-2-7-5z" />
      <path class="ts-kibble" d="M110 8c0-4 4-6 8-6s7 2 7 5-3 6-8 6-7-2-7-5z" />
      <path class="ts-kibble" d="M104 8c0-4 4-6 8-6s7 2 7 5-3 6-8 6-7-2-7-5z" />
    </g>
  {%- elsif scene == 'party' -%}
    <g class="ts-pop">
      <path class="ts-kibble" d="M58 40c0-4 4-6 8-6s7 2 7 5-3 6-8 6-7-2-7-5z" />
      <path class="ts-kibble" d="M150 30c0-4 4-6 8-6s7 2 7 5-3 6-8 6-7-2-7-5z" />
      <path class="ts-kibble" d="M172 70c0-4 4-6 8-6s7 2 7 5-3 6-8 6-7-2-7-5z" />
      <path class="ts-heart" d="M40 80c-6-6-2-14 4-12 2 1 3 2 4 4 1-2 2-3 4-4 6-2 10 6 4 12l-8 7z" />
    </g>
  {%- endif -%}
</svg>
