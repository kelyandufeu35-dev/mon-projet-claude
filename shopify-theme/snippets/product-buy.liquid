{%- comment -%}
  Zone d’achat (v9 Cinéma) : galerie, titre, prix, offres groupées, bouton,
  garanties, volets « Ce que tu reçois » et « Quelle taille ». Barre d’achat
  mobile et données structurées en fin de snippet.
  Paramètres : product, section, reveal (booléen : révélations au défilement,
  accueil seulement ; jamais sur le prix, les offres, le bouton ni les garanties),
  scene (booléen : 1er média = la balle 3D du haut de page sur scène sombre, page produit).
  Contrat avec theme.js et motion.js : attributs data-* (FINAL_SPEC § 3.5).
  Styles : assets/sections-v9.css (préfixe pt-).
{%- endcomment -%}
{%- liquid
  comment
    Titre affiché sans le suffixe « – Pattoune » (gardé dans les données produit, le SEO et le JSON-LD).
  endcomment
  assign buy_title = product.title | split: ' – ' | first
  assign current = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id
  assign price = current.price
  assign anchor = section.settings.anchor | default: 'acheter'
  assign unit_singular = section.settings.unit_singular
  if unit_singular == blank
    assign unit_singular = 'snippets.product_buy.unit_singular' | t
  endif
  assign unit_plural = section.settings.unit_plural
  if unit_plural == blank
    assign unit_plural = 'snippets.product_buy.unit_plural' | t
  endif

  assign offer_qtys = '1'
  assign offer_discounts = '0'
  assign offer_badges = ''
  # Montants fixes en euros : hors euro (autre marché), on affiche la remise en % équivalente,
  # Shopify convertissant lui-même la remise fixe au paiement (écart < 1 centime par balle).
  assign offer_amounts = '0'
  # Offres groupées désactivables par section (réglage absent = activées, ex. accueil).
  assign show_offers = true
  if section.settings.show_offers == false
    assign show_offers = false
  endif
  if show_offers and settings.bundle1_qty > 1
    assign offer_qtys = offer_qtys | append: ',' | append: settings.bundle1_qty
    assign offer_discounts = offer_discounts | append: ',' | append: settings.bundle1_discount
    assign offer_badges = offer_badges | append: '|' | append: settings.bundle1_badge
    assign amount_cents = settings.bundle1_amount | replace: ',', '.' | times: 100 | round
    if cart.currency.iso_code != shop.currency
      assign amount_cents = 0
    endif
    assign offer_amounts = offer_amounts | append: ',' | append: amount_cents
  endif
  if show_offers and settings.bundle2_qty > settings.bundle1_qty
    assign offer_qtys = offer_qtys | append: ',' | append: settings.bundle2_qty
    assign offer_discounts = offer_discounts | append: ',' | append: settings.bundle2_discount
    assign offer_badges = offer_badges | append: '|' | append: settings.bundle2_badge
    assign amount_cents = settings.bundle2_amount | replace: ',', '.' | times: 100 | round
    if cart.currency.iso_code != shop.currency
      assign amount_cents = 0
    endif
    assign offer_amounts = offer_amounts | append: ',' | append: amount_cents
  endif
  assign qtys = offer_qtys | split: ','
  assign discounts = offer_discounts | split: ','
  assign badges = offer_badges | split: '|'
  assign amounts = offer_amounts | split: ','
  assign preselect = section.settings.preselect_offer | default: 1
  if preselect > qtys.size
    assign preselect = qtys.size
  endif

  assign initial_media_id = current.featured_media.id | default: product.featured_media.id
  if scene
    assign initial_media_id = 'scene'
  endif
  assign selected_total = price

  # Livraison : offerte dès le seuil (Paramètres du thème → Livraison et remises), payante en dessous.
  assign ship_threshold = settings.free_shipping_threshold | default: 0 | times: 100
  assign ship_fee = settings.shipping_fee | default: 0
  capture ship_threshold_money
    render 'pt-money', cents: ship_threshold
  endcapture
  assign ship_threshold_money = ship_threshold_money | strip | replace: ',00', '' | replace: '&nbsp;', ' '
-%}

<div class="pt-buy-grid" data-product-root data-section="{{ section.id }}">
  {%- comment -%} Galerie : volet à l’entrée (accueil), fondu doux au changement de photo. {%- endcomment -%}
  {%- liquid
    assign thumbs = product.media.size
    if scene
      assign thumbs = thumbs | plus: 1
    endif
  -%}
  <div class="pt-gallery" data-gallery>
    <div class="pt-gallery__main"{% if reveal %} data-reveal="clip"{% endif %}{% if thumbs > 1 %} data-gallery-main{% endif %}>
      {%- if scene -%}
        <div class="pt-gallery__slide pt-gallery__slide--scene" data-media-id="scene"{% if initial_media_id != 'scene' %} hidden{% endif %}>
          <picture>
            <source type="image/webp" srcset="{{ 'pt-hero-poster-720.webp' | asset_url }} 720w, {{ 'pt-hero-poster.webp' | asset_url }} 1080w" sizes="(min-width: 900px) 52vw, 100vw">
            <img src="{{ 'pt-hero-poster.jpg' | asset_url }}" width="1080" height="1440" alt="{{ 'snippets.product_buy.scene_alt' | t: title: product.title }}" loading="eager" fetchpriority="high" decoding="async">
          </picture>
          <span class="pt-step__vid" data-step-video aria-hidden="true">
            <video muted loop playsinline preload="none" width="1080" height="1440">
              <source src="{{ 'pt-hero-loop.webm' | asset_url }}" type="video/webm">
              <source src="{{ 'pt-hero-loop.mp4' | asset_url }}" type="video/mp4">
            </video>
          </span>
        </div>
      {%- endif -%}
      {%- if product.media.size > 0 -%}
        {%- for media in product.media -%}
          {%- liquid
            assign loading = 'lazy'
            if media.id == initial_media_id
              assign loading = 'eager'
            endif
          -%}
          {%- assign media_alt = media.alt | default: product.title -%}
          <div class="pt-gallery__slide" data-media-id="{{ media.id }}"{% if media.id != initial_media_id %} hidden{% endif %}>
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {{ media | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 900px) 52vw, 100vw', loading: loading, alt: media_alt }}
              {%- when 'video' -%}
                {%- comment -%} Ni lecture automatique ni préchargement : theme.js la lance quand on la choisit (hors mouvement réduit) ; commandes natives (pause, son). {%- endcomment -%}
                <div class="pt-gallery__video" data-video>
                  {{ media | video_tag: autoplay: false, loop: true, muted: true, controls: true, playsinline: true, preload: 'none', image_size: '1200x' }}
                </div>
              {%- when 'external_video' -%}
                {{ media | media_tag: image_size: '1200x', autoplay: false, loop: true, controls: true }}
              {%- when 'model' -%}
                {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true }}
              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="pt-gallery__slide pt-gallery__slide--3d">
          <img src="{{ 'pt-balle-3d.webp' | asset_url }}" alt="{{ product.title | escape }}" width="236" height="236" loading="eager" decoding="async">
        </div>
      {%- endif -%}
      {%- comment -%} Carrousel : flèches, compteur (glisser au doigt et flèches du clavier dans theme.js). {%- endcomment -%}
      {%- if thumbs > 1 -%}
        <button type="button" class="pt-gallery__nav pt-gallery__nav--prev" data-gallery-prev aria-label="{{ 'snippets.product_buy.gallery_prev' | t }}">{% render 'icon', name: 'arrow' %}</button>
        <button type="button" class="pt-gallery__nav pt-gallery__nav--next" data-gallery-next aria-label="{{ 'snippets.product_buy.gallery_next' | t }}">{% render 'icon', name: 'arrow' %}</button>
        <span class="pt-gallery__count" aria-hidden="true"><span data-gallery-index>1</span> / {{ thumbs }}</span>
      {%- endif -%}
    </div>
    {%- if thumbs > 1 -%}
      <div class="pt-gallery__thumbs" role="group" aria-label="{{ 'snippets.product_buy.gallery_label' | t }}"{% if reveal %} data-reveal-group{% endif %}>
        {%- if scene -%}
          <button type="button" class="pt-thumb pt-thumb--scene" data-thumb="scene" aria-label="{{ 'snippets.product_buy.scene_thumb' | t }}" aria-pressed="{% if initial_media_id == 'scene' %}true{% else %}false{% endif %}">
            <img src="{{ 'pt-hero-poster-720.webp' | asset_url }}" alt="" width="720" height="960" loading="lazy" decoding="async">
            <span class="pt-thumb__play" aria-hidden="true">{% render 'icon', name: 'play' %}</span>
          </button>
        {%- endif -%}
        {%- for media in product.media -%}
          <button type="button" class="pt-thumb" data-thumb="{{ media.id }}" aria-label="{% if media.media_type == 'video' or media.media_type == 'external_video' %}{{ 'snippets.product_buy.thumb_video' | t: number: forloop.index }}{% else %}{{ 'snippets.product_buy.thumb_photo' | t: number: forloop.index }}{% endif %}" aria-pressed="{% if media.id == initial_media_id %}true{% else %}false{% endif %}"{% if reveal %} data-reveal="up"{% endif %}>
            {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}<span class="pt-thumb__play" aria-hidden="true">{% render 'icon', name: 'play' %}</span>{%- endif -%}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Colonne d’achat : rien n’y est jamais caché (prix, offres, bouton, garanties). {%- endcomment -%}
  <div class="pt-buy">
    {%- if section.settings.eyebrow != blank -%}
      <p class="pt-eyebrow pt-eyebrow--red"{% if reveal %} data-reveal="up"{% endif %}>{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.title_as_h1 -%}
      <h1 class="pt-buy__title" id="pt-buy-title-{{ section.id }}"{% if reveal %} data-reveal="mask" style="--pt-d:1"{% endif %}>{% render 'pt-split', text: buy_title %}</h1>
    {%- else -%}
      <h2 class="pt-buy__title" id="pt-buy-title-{{ section.id }}"{% if reveal %} data-reveal="mask" style="--pt-d:1"{% endif %}>{% render 'pt-split', text: buy_title %}</h2>
    {%- endif -%}

    {%- comment -%} Accroche de 4-5 mots (métachamp produit custom.accroche, traduit). {%- endcomment -%}
    {%- assign hook = product.metafields.custom.accroche.value -%}
    {%- if hook != blank -%}
      <p class="pt-buy__hook"{% if reveal %} data-reveal="up" style="--pt-d:2"{% endif %}>{{ hook | escape }}</p>
    {%- endif -%}

    <p class="pt-buy__price">
      <span class="pt-buy__amount" data-price>{% render 'pt-money', cents: price %}</span>
      <s data-compare{% unless current.compare_at_price > current.price %} hidden{% endunless %}>{% render 'pt-money', cents: current.compare_at_price %}</s>
      <span class="pt-buy__ttc">{% if ship_threshold > 0 and price < ship_threshold %}{{ 'snippets.product_buy.price_note_from' | t: amount: ship_threshold_money }}{% else %}{{ 'snippets.product_buy.price_note' | t }}{% endif %}</span>
    </p>

    {% form 'product', product, id: form_id, class: 'pt-buy__form', novalidate: 'novalidate', data-product-form: '' %}
      <input type="hidden" name="id" value="{{ current.id }}" data-variant-input>
      {%- comment -%} Quantité : portée par l’offre cochée (radios name="quantity"), juste même sans JS. {%- endcomment -%}
      {%- if qtys.size < 2 -%}<input type="hidden" name="quantity" value="1">{%- endif -%}

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          {%- assign option_index = forloop.index0 -%}
          <fieldset class="pt-field{% if option.values.size == 1 %} pt-field--single{% endif %}" data-option="{{ forloop.index0 }}">
            <legend>{{ option.name | escape }}{{ 'snippets.product_buy.option_colon' | t }} <strong data-option-label>{{ option.selected_value | escape }}</strong></legend>
            <div class="pt-swatches">
              {%- for value in option.values -%}
                <label class="pt-swatch">
                  <input type="radio" name="option-{{ option_index }}-{{ section.id }}" value="{{ value | escape }}" autocomplete="off"{% if option.selected_value == value %} checked{% endif %}>
                  {%- if value.swatch.color -%}
                    <span class="pt-swatch__dot" style="background: {{ value.swatch.color }}"></span>
                  {%- elsif value.swatch.image -%}
                    <span class="pt-swatch__dot" style="background-image: url({{ value.swatch.image | image_url: width: 88 }}); background-size: cover"></span>
                  {%- endif -%}
                  <span class="pt-swatch__name">{{ value | escape }}</span>
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}

      {%- if qtys.size > 1 -%}
        <fieldset class="pt-offers"{% if reveal %} data-reveal="none"{% endif %}>
          <legend>{{ section.settings.offers_legend | escape }}</legend>
          {%- for q in qtys -%}
            {%- liquid
              assign qn = q | plus: 0
              assign d = discounts[forloop.index0] | plus: 0
              assign full = price | times: qn
              comment
                Remise par article : montant fixe s'il est renseigné (aucun
                arrondi possible), sinon pourcentage arrondi à l'inférieur.
              endcomment
              assign unit_off = amounts[forloop.index0] | plus: 0
              if unit_off > 0
                assign unit_saved = unit_off
                assign d = unit_off | times: 100.0 | divided_by: price | round
              else
                assign unit_saved = price | times: d | divided_by: 100
              endif
              assign saved = unit_saved | times: qn
              assign total = full | minus: saved
              assign badge = badges[forloop.index0]
              if forloop.index == preselect
                assign selected_total = total
              endif
            -%}
            <label class="pt-offer" data-offer-card>
              <input class="pt-offer__input" type="radio" name="quantity" value="{{ qn }}" autocomplete="off" data-offer data-discount="{{ d }}"{% if unit_off > 0 %} data-unit-off="{{ unit_off }}"{% endif %}{% if forloop.index == preselect %} checked{% endif %}>
              <span class="pt-offer__dot" aria-hidden="true"></span>
              <span class="pt-offer__name">
                {{- qn }} {% if qn > 1 %}{{ unit_plural | escape }}{% else %}{{ unit_singular | escape }}{% endif -%}
                {%- if badge != blank %} <span class="pt-badge{% if forloop.last %} pt-badge--sun{% endif %}">{{ badge | escape }}</span>{% endif -%}
              </span>
              <span class="pt-offer__unit">
                {%- if qn > 1 -%}<span data-offer-unit>{%- assign unit_price = total | divided_by: qn -%}{% render 'pt-money', cents: unit_price %}</span> {{ 'snippets.product_buy.per_unit' | t }}{%- else -%}{{ 'snippets.product_buy.unit_price' | t }}{%- endif -%}
                {%- if d > 0 %} · <em>{{ 'snippets.product_buy.percent_off' | t: percent: d }}</em>{% endif -%}
              </span>
              <span class="pt-offer__total">
                <strong data-offer-total>{% render 'pt-money', cents: total %}</strong>
                {%- if d > 0 %}<span class="pt-sr"> {{ 'snippets.product_buy.instead_of' | t }} </span>{% endif -%}
                <s data-offer-full{% if d == 0 %} hidden{% endif %}>{% render 'pt-money', cents: full %}</s>
              </span>
            </label>
          {%- endfor -%}
        </fieldset>
        <p class="pt-offers__note">{{ 'snippets.product_buy.discount_note' | t }}</p>
      {%- endif -%}

      <button type="submit" name="add" class="pt-btn pt-btn--ink pt-btn--xl pt-btn--block pt-add" data-add-button data-magnetic{% unless current.available %} disabled{% endunless %}>
        <span class="pt-add__label" data-add-label>
          {%- if current.available -%}{{ 'product.add' | t }}{%- else -%}{{ 'product.sold_out' | t }}{%- endif -%}
        </span>
        <span class="pt-btn__sep" aria-hidden="true"></span>
        <span class="pt-add__total" data-add-total>{% render 'pt-money', cents: selected_total %}</span>
        <svg class="pt-add__check" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path pathLength="1" d="m5 12.5 4.2 4L19 7"/></svg>
      </button>
      <p class="pt-form-error" role="alert" data-form-error hidden></p>
    {% endform %}

    <ul class="pt-trust">
      {%- if section.settings.trust_1 != blank -%}<li>{% render 'icon', name: 'truck' %}<span>{{ section.settings.trust_1 | escape }}</span></li>{%- endif -%}
      {%- if section.settings.trust_2 != blank -%}<li>{% render 'icon', name: 'return' %}<span>{{ section.settings.trust_2 | escape }}</span></li>{%- endif -%}
      {%- if section.settings.trust_3 != blank -%}<li>{% render 'icon', name: 'lock' %}<span>{{ section.settings.trust_3 | escape }}</span></li>{%- endif -%}
    </ul>

    <div class="pt-more-group">
      {%- if section.settings.inbox != blank -%}
        <details class="pt-more">
          <summary><span>{{ 'snippets.product_buy.inbox_title' | t }}</span><span class="pt-plus" aria-hidden="true"></span></summary>
          <ul class="pt-more__body">
            {%- assign inbox_lines = section.settings.inbox | newline_to_br | split: '<br />' -%}
            {%- for line in inbox_lines -%}
              {%- assign l = line | strip -%}
              {%- if l != blank -%}<li>{{ l | escape }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        </details>
      {%- endif -%}

      {%- if section.settings.size_guide -%}
        <details class="pt-more">
          <summary><span>{{ 'snippets.product_buy.size_title' | t }}</span><span class="pt-plus" aria-hidden="true"></span></summary>
          <ul class="pt-more__body">
            <li>{{ 'snippets.product_buy.size_cats_html' | t }}</li>
            <li>{{ 'snippets.product_buy.size_small_dogs_html' | t }}</li>
            <li>{{ 'snippets.product_buy.size_big_dogs_html' | t }}</li>
          </ul>
        </details>
      {%- endif -%}

      {%- if section.settings.show_description and product.description != blank -%}
        <details class="pt-more">
          <summary><span>{{ 'snippets.product_buy.description' | t }}</span><span class="pt-plus" aria-hidden="true"></span></summary>
          <div class="pt-more__body rte">{{ product.description }}</div>
        </details>
      {%- endif -%}
    </div>
  </div>

  <script type="application/json" data-product-json>
    {
      "variants": [
        {%- for v in product.variants -%}
          {"id": {{ v.id }}, "options": {{ v.options | json }}, "price": {{ v.price }}, "compare": {{ v.compare_at_price | default: 0 }}, "available": {{ v.available }}, "media": {{ v.featured_media.id | default: 0 }}}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "currency": {{ cart.currency.iso_code | json }}
    }
  </script>
</div>

{%- comment -%} Barre d’achat mobile : affichée par theme.js (data-show) hors du haut de page, de la zone d’achat et de la fin. {%- endcomment -%}
{%- comment -%}
  div et non aside : la barre vit dans <main> et dans la section, or un repère
  « complementary » imbriqué est signalé par axe (landmark-complementary-is-top-level).
{%- endcomment -%}
<div class="pt-sticky" data-sticky-buy aria-hidden="true">
  <p class="pt-sticky__text">
    <strong>{{ section.settings.sticky_label | default: buy_title | escape }}</strong>
    <span><span data-sticky-price>{% render 'pt-money', cents: price %}</span> · {% if ship_threshold > 0 and price < ship_threshold %}{{ 'snippets.product_buy.sticky_shipping_from' | t: amount: ship_threshold_money }}{% else %}{{ 'snippets.product_buy.sticky_shipping' | t }}{% endif %}</span>
  </p>
  <a class="pt-btn pt-btn--sun pt-sticky__btn" href="#{{ anchor | escape }}" tabindex="-1">{{ 'snippets.product_buy.sticky_button' | t }}</a>
</div>

{%- liquid
  assign seo_media = product.featured_media
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if seo_media -%}
      "image": [{{ seo_media | image_url: width: 1200 | prepend: 'https:' | json }}],
    {%- endif -%}
    "description": {{ product.description | strip_html | truncate: 500 | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | default: settings.brand_name | default: shop.name | json }} },
    "offers": [
      {%- for v in product.variants -%}
        {
          "@type": "Offer",
          {%- if v.sku != blank -%}"sku": {{ v.sku | json }},{%- endif -%}
          "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
          "itemCondition": "https://schema.org/NewCondition",
          "price": {{ v.price | divided_by: 100.00 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "url": {{ request.origin | append: v.url | json }},
          "seller": { "@type": "Organization", "name": {{ shop.name | json }} },
          "shippingDetails": {
            "@type": "OfferShippingDetails",
            "shippingRate": { "@type": "MonetaryAmount", "value": {% if ship_threshold > 0 and v.price < ship_threshold %}{{ ship_fee | plus: 0 | json }}{% else %}0{% endif %}, "currency": {{ cart.currency.iso_code | json }} },
            "shippingDestination": { "@type": "DefinedRegion", "addressCountry": ["FR","BE","LU","DE","AT","NL","IT","ES","PT","IE","DK","SE","FI","EE","LV","LT","PL","CZ","SK","SI","HR","HU","RO","BG","GR","CY","MT","CH"] },
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "handlingTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 3, "unitCode": "DAY" },
              "transitTime": { "@type": "QuantitativeValue", "minValue": 7, "maxValue": 22, "unitCode": "DAY" }
            }
          },
          "hasMerchantReturnPolicy": {
            "@type": "MerchantReturnPolicy",
            "applicableCountry": ["FR","BE","LU","DE","AT","NL","IT","ES","PT","IE","DK","SE","FI","EE","LV","LT","PL","CZ","SK","SI","HR","HU","RO","BG","GR","CY","MT","CH"],
            "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
            "merchantReturnDays": 14,
            "returnMethod": "https://schema.org/ReturnByMail",
            "returnFees": "https://schema.org/ReturnFeesCustomerResponsibility"
          }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
