{%- comment -%}
  Icône en ligne. Paramètre : name ('paw', 'bag', 'truck', 'return', 'lock', 'nose', 'clock', 'spark', 'drop', 'check', 'close', 'minus', 'plus', 'arrow', 'mail', 'star').
{%- endcomment -%}
{%- case name -%}
  {%- when 'paw' -%}
    <svg class="icon" width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><ellipse cx="6" cy="9.5" rx="2.1" ry="2.6"/><ellipse cx="10" cy="5.8" rx="2.1" ry="2.6"/><ellipse cx="14.4" cy="5.8" rx="2.1" ry="2.6"/><ellipse cx="18.3" cy="9.6" rx="2.1" ry="2.6"/><path d="M12.2 11.2c-3.3 0-6.2 3.4-6.2 6.1 0 2 1.6 2.9 3.2 2.9 1.2 0 2-.6 3-.6s1.8.6 3 .6c1.6 0 3.2-.9 3.2-2.9 0-2.7-2.9-6.1-6.2-6.1Z"/></svg>
  {%- when 'star' -%}
    <svg class="icon" width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"/></svg>
  {%- else -%}
    <svg class="icon" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{% if name == 'check' %}2.4{% else %}1.8{% endif %}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      {%- case name -%}
        {%- when 'bag' -%}<path d="M5 8h14l-1.2 12H6.2L5 8Z"/><path d="M9 10V7a3 3 0 0 1 6 0v3"/>
        {%- when 'truck' -%}<path d="M3 6h11v10H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
        {%- when 'return' -%}<path d="M9 14 4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/>
        {%- when 'lock' -%}<rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>
        {%- when 'nose' -%}<path d="M12 4c4 0 7 3 7 7 0 3-2 5-4 6l-3 3-3-3c-2-1-4-3-4-6 0-4 3-7 7-7Z"/><path d="M9.5 10.5h.01M14.5 10.5h.01" stroke-width="3"/>
        {%- when 'clock' -%}<circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/>
        {%- when 'spark' -%}<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/>
        {%- when 'drop' -%}<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z"/>
        {%- when 'check' -%}<path d="m5 12.5 4.2 4L19 7"/>
        {%- when 'close' -%}<path d="M6 6l12 12M18 6 6 18"/>
        {%- when 'minus' -%}<path d="M6 12h12"/>
        {%- when 'plus' -%}<path d="M12 6v12M6 12h12"/>
        {%- when 'arrow' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
        {%- when 'mail' -%}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>
      {%- endcase -%}
    </svg>
{%- endcase -%}
