<section class="page wrap password">
  <h1 class="h1">{{ settings.brand_name | default: shop.name }}</h1>
  {%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'customer', class: 'form' -%}
    {%- if form.posted_successfully? -%}
      <p class="notice notice--ok" role="status">{{ 'sections.main_password.success' | t }}</p>
    {%- else -%}
      <input type="hidden" name="contact[tags]" value="prospect, password page">
      <div class="field">
        <label for="PasswordEmail">{{ 'sections.main_password.email_label' | t }}</label>
        <input id="PasswordEmail" type="email" name="contact[email]" autocomplete="email" required>
      </div>
      <button type="submit" class="btn btn--sun">{{ 'sections.main_password.submit' | t }}</button>
    {%- endif -%}
  {%- endform -%}
  <details class="password__login">
    <summary>{{ 'sections.main_password.owner' | t }}</summary>
    {%- form 'storefront_password', class: 'form' -%}
      {{ form.errors | default_errors }}
      <div class="field">
        <label for="Password">{{ 'sections.main_password.password' | t }}</label>
        <input id="Password" type="password" name="password" autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn--ink">{{ 'sections.main_password.enter' | t }}</button>
    {%- endform -%}
  </details>
</section>

{% schema %}
{
  "name": "Page mot de passe",
  "settings": []
}
{% endschema %}
