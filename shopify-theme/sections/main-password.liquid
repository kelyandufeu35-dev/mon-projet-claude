<section class="page wrap password">
  <h1 class="h1">{{ shop.name }}</h1>
  {%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'customer', class: 'form' -%}
    {%- if form.posted_successfully? -%}
      <p class="notice notice--ok" role="status">Merci, on te prévient dès l’ouverture.</p>
    {%- else -%}
      <input type="hidden" name="contact[tags]" value="prospect, password page">
      <div class="field">
        <label for="PasswordEmail">Ton e-mail pour être prévenu·e de l’ouverture</label>
        <input id="PasswordEmail" type="email" name="contact[email]" autocomplete="email" required>
      </div>
      <button type="submit" class="btn btn--sun">Me prévenir</button>
    {%- endif -%}
  {%- endform -%}
  <details class="password__login">
    <summary>Accès propriétaire</summary>
    {%- form 'storefront_password', class: 'form' -%}
      {{ form.errors | default_errors }}
      <div class="field">
        <label for="Password">Mot de passe</label>
        <input id="Password" type="password" name="password" autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn--ink">Entrer</button>
    {%- endform -%}
  </details>
</section>

{% schema %}
{
  "name": "Page mot de passe",
  "settings": []
}
{% endschema %}
