{%- comment -%}
  Panier latéral. Rafraîchi par theme.js via l’API Section Rendering après
  chaque ajout ou changement de quantité.
{%- endcomment -%}
<dialog id="cart-drawer" class="drawer" aria-labelledby="cart-drawer-title">
  <div class="drawer__panel" data-cart-drawer-content>
    <div class="drawer__head">
      <h2 id="cart-drawer-title">{{ 'cart.title' | t }}</h2>
      <button type="button" class="icon-btn" data-cart-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="drawer__empty">
        <span class="drawer__empty-icon" aria-hidden="true">{% render 'icon', name: 'paw' %}</span>
        <p>{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--sun" data-cart-close>{{ 'cart.discover' | t }}</a>
      </div>
    {%- else -%}
      {% render 'cart-summary', compact: true %}
    {%- endif -%}
  </div>
</dialog>

{% stylesheet %}
  /* Rappel du code de bienvenue (snippets/cart-summary.liquid). */
  .pt-promo {
    margin: 0;
    padding: 12px 16px;
    border-radius: 16px;
    background: var(--pt-sun, #ffc23a);
    color: var(--pt-ink, #14162b);
    font-size: var(--step--1);
    line-height: 1.4;
  }
  .pt-promo strong { letter-spacing: 0.04em; white-space: nowrap; }
  .pt-promo__hint { display: block; opacity: 0.75; }
{% endstylesheet %}

{% schema %}
{
  "name": "Panier latéral",
  "settings": []
}
{% endschema %}
