<section class="section final">
  <div class="final__paws" aria-hidden="true">
    {%- for i in (1..6) -%}<span style="--i: {{ i }}">{% render 'icon', name: 'paw' %}</span>{%- endfor -%}
  </div>
  <div class="wrap final__inner">
    <div class="final__text">
      {%- if section.settings.title != blank -%}<h2 class="final__title">{{ section.settings.title | escape }}</h2>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#contenu' }}" class="btn btn--ink btn--lg" data-scroll-buy>{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="final__art">{% render 'toy-scene', scene: 'party' %}</div>
  </div>
</section>

{% schema %}
{
  "name": "Appel à l’action",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Une balle, une poignée de croquettes, et le salon redevient calme."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Choisir ma couleur"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton",
      "info": "Vide = remonte vers le bouton d’achat."
    }
  ],
  "presets": [
    {
      "name": "Appel à l’action"
    }
  ]
}
{% endschema %}
