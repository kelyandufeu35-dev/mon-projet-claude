{%- if section.settings.text != blank -%}
  <p class="announce">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
    {%- else -%}
      {{ section.settings.text | escape }}
    {%- endif -%}
  </p>
{%- endif -%}

{% schema %}
{
  "name": "Bandeau d’annonce",
  "class": "section-announcement",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "text", "label": "Texte", "default": "Livraison offerte dès 35 € · Retours sous 14 jours" },
    { "type": "url", "id": "link", "label": "Lien (facultatif)" }
  ],
  "presets": [{ "name": "Bandeau d’annonce" }]
}
{% endschema %}
