<header class="header">
  <div class="header__inner wrap">
    <a href="{{ routes.root_url }}" class="logo">
      {%- if settings.logo != blank -%}
        {%- assign logo_style = 'width: ' | append: settings.logo_width | append: 'px' -%}
        {{ settings.logo | image_url: width: 480 | image_tag: alt: shop.name, class: 'logo__img', style: logo_style, widths: '160, 240, 320, 480', sizes: '240px' }}
      {%- else -%}
        <span class="logo__mark">{% render 'icon', name: 'paw' %}</span>
        <span class="logo__name">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    {%- if section.settings.menu != blank -%}
      <nav class="header__nav" aria-label="Navigation principale">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <a href="{{ routes.cart_url }}" class="cart-btn" data-cart-open aria-label="Panier, {{ cart.item_count }} article{% if cart.item_count > 1 %}s{% endif %}">
      {% render 'icon', name: 'bag' %}
      <span class="cart-btn__label">Panier</span>
      <span class="cart-btn__count" data-cart-count{% if cart.item_count == 0 %} data-empty{% endif %}>{{ cart.item_count }}</span>
    </a>
  </div>
</header>

{% schema %}
{
  "name": "En-tête",
  "class": "section-header",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Crée un menu dans Contenu → Menus (ex. « Le jouet », « Comment ça marche », « Questions », « Livraison »)."
    }
  ]
}
{% endschema %}
