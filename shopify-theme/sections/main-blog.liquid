<section class="page page--wide wrap">
  <h1 class="h1">{{ blog.title | escape }}</h1>
  {%- paginate blog.articles by 12 -%}
    <ul class="grid">
      {%- for article in blog.articles -%}
        <li>
          <a href="{{ article.url }}" class="card">
            {%- if article.image -%}{{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: article.title }}{%- endif -%}
            <span class="card__title">{{ article.title | escape }}</span>
            <span class="card__meta">{{ article.published_at | date: format: 'numeric' }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}{{ paginate | default_pagination }}{%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
