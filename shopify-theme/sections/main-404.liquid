<section class="page wrap page--lost">
  <div class="page--lost__art"><img class="pt-lost__ball" src="{{ 'pt-balle-3d.webp' | asset_url }}" alt="" width="236" height="236" decoding="async"></div>
  <h1 class="h1">{{ 'sections.main_404.title' | t }}</h1>
  <p class="lead">{{ 'sections.main_404.text' | t }}</p>
  <p><a href="{{ routes.root_url }}" class="pt-btn pt-btn--ink pt-btn--xl">{{ 'sections.main_404.button' | t }}<span class="pt-btn__arrow" aria-hidden="true">{% render 'icon', name: 'arrow' %}</span></a></p>
</section>

{% schema %}
{
  "name": "Page 404",
  "settings": []
}
{% endschema %}
