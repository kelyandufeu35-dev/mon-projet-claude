<section class="section promise">
  <div class="wrap">
    <h2 class="visually-hidden">Nos engagements</h2>
    <ul class="promise__grid">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon %}
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Engagements",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Engagement",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            {
              "value": "nose",
              "label": "Nez / flair"
            },
            {
              "value": "clock",
              "label": "Horloge"
            },
            {
              "value": "spark",
              "label": "Étincelle"
            },
            {
              "value": "drop",
              "label": "Goutte d’eau"
            },
            {
              "value": "paw",
              "label": "Patte"
            },
            {
              "value": "truck",
              "label": "Camion"
            },
            {
              "value": "check",
              "label": "Coche"
            },
            {
              "value": "return",
              "label": "Retour"
            },
            {
              "value": "mail",
              "label": "E-mail"
            },
            {
              "value": "lock",
              "label": "Cadenas"
            }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Engagement"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Détail"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Engagements",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "Livraison offerte dès 35 €",
            "text": "Livré en 7 à 14 jours ouvrés avec numéro de suivi."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "return",
            "title": "14 jours pour changer d’avis",
            "text": "Tu peux te rétracter sans justification."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "mail",
            "title": "Une vraie personne répond",
            "text": "Écris-nous, réponse sous 48 h ouvrées."
          }
        }
      ]
    }
  ]
}
{% endschema %}
