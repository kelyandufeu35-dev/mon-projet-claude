<section class="password">
  <div class="password__art">{% render 'squishy-art', animated: true, label: shop.name %}</div>
  <h1 class="display">{{ shop.name | escape }}</h1>
  <p class="password__message">{{ shop.password_message | default: section.settings.message | escape }}</p>

  {%- form 'customer', class: 'password__signup' -%}
    <input type="hidden" name="contact[tags]" value="newsletter, ouverture">
    {%- if form.posted_successfully? -%}
      <p class="form__success" role="status">C'est noté, on te prévient à l'ouverture !</p>
    {%- else -%}
      <label for="PasswordEmail" class="visually-hidden">E-mail</label>
      <input id="PasswordEmail" type="email" name="contact[email]" placeholder="Ton e-mail" required autocomplete="email">
      <button type="submit" class="button button--primary">Prévenez-moi</button>
      {%- if form.errors -%}<div class="form__error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    {%- endif -%}
  {%- endform -%}

  <details class="password__login">
    <summary>Accès propriétaire</summary>
    {%- form 'storefront_password' -%}
      <label for="StorePassword" class="visually-hidden">Mot de passe</label>
      <input id="StorePassword" type="password" name="password" placeholder="Mot de passe" autocomplete="current-password">
      <button type="submit" class="button">Entrer</button>
      {%- if form.errors -%}<div class="form__error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    {%- endform -%}
  </details>
</section>

{% schema %}
{
  "name": "Page mot de passe",
  "settings": [
    { "type": "text", "id": "message", "label": "Message", "default": "Les squishy arrivent très bientôt !" }
  ]
}
{% endschema %}
