{%- assign menu = section.settings.menu -%}
<header class="header" data-header>
  <div class="header__inner page-width">
    {%- if menu.links.size > 0 -%}
      <details class="mobile-nav" data-mobile-nav>
        <summary class="icon-button mobile-nav__toggle" aria-label="Ouvrir le menu">
          {% render 'icon', name: 'menu' %}
        </summary>
        <div class="mobile-nav__panel">
          <nav aria-label="Menu principal">
            <ul class="mobile-nav__list" role="list">
              {%- for link in menu.links -%}
                <li>
                  <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                  {%- if link.links.size > 0 -%}
                    <ul role="list">
                      {%- for child in link.links -%}
                        <li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        </div>
      </details>
    {%- endif -%}

    {%- if request.page_type == 'index' -%}<h1 class="header__brand">{%- else -%}<div class="header__brand">{%- endif -%}
      <a href="{{ routes.root_url }}" class="logo">
        {%- if settings.logo != blank -%}
          {%- liquid
            assign logo_w2 = settings.logo_width | times: 2
            assign logo_h = settings.logo_width | divided_by: settings.logo.aspect_ratio | round
          -%}
          {{ settings.logo | image_url: width: logo_w2 | image_tag:
            width: settings.logo_width,
            height: logo_h,
            alt: shop.name,
            loading: 'eager',
            class: 'logo__img'
          }}
        {%- else -%}
          <svg class="logo__mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false"><path d="M17 19C9 24 9 36 18 46C23 52 28 55 32 55C36 55 41 52 46 46C55 36 55 24 47 19C42 15 22 15 17 19Z" fill="#E8302A"/><g fill="#9E1B1B" opacity=".55"><ellipse cx="24" cy="28" rx="1.6" ry="2.2"/><ellipse cx="32" cy="27" rx="1.6" ry="2.2"/><ellipse cx="40" cy="28" rx="1.6" ry="2.2"/><ellipse cx="28" cy="36" rx="1.6" ry="2.2"/><ellipse cx="36" cy="36" rx="1.6" ry="2.2"/><ellipse cx="32" cy="44" rx="1.6" ry="2.2"/></g><path d="M32 18C28 13 20 12 13 15C18 19 25 20 32 18ZM32 18C36 13 44 12 51 15C46 19 39 20 32 18ZM32 18C30 14 30 9 32 5C34 9 34 14 32 18Z" fill="#2C7A35"/></svg>
          <span class="logo__text">{{ shop.name | escape }}</span>
        {%- endif -%}
      </a>
    {%- if request.page_type == 'index' -%}</h1>{%- else -%}</div>{%- endif -%}

    {%- if menu.links.size > 0 -%}
      <nav class="header__nav" aria-label="Menu principal">
        <ul role="list">
          {%- for link in menu.links -%}
            <li><a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="header__icons">
      {%- if section.settings.show_search -%}
        <a href="{{ routes.search_url }}" class="icon-button" aria-label="Rechercher">{% render 'icon', name: 'search' %}</a>
      {%- endif -%}
      {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
        <a href="{{ routes.account_url }}" class="icon-button" aria-label="Mon compte">{% render 'icon', name: 'user' %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="icon-button cart-link" data-cart-open aria-label="Panier, {{ cart.item_count }} article{% if cart.item_count > 1 %}s{% endif %}">
        {% render 'icon', name: 'bag' %}
        <span class="cart-link__count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "En-tête",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    { "type": "checkbox", "id": "show_search", "label": "Afficher la recherche", "default": false },
    { "type": "checkbox", "id": "show_account", "label": "Afficher le compte client", "default": false }
  ]
}
{% endschema %}
