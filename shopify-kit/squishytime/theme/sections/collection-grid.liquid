{%- liquid
  assign coll = section.settings.collection
  assign show = true
  if coll == blank
    assign show = false
  elsif section.settings.hide_if_single and coll.products_count < 2
    assign show = false
  endif
-%}
{%- if show -%}
  <section class="section section--{{ section.settings.background }}">
    <div class="page-width">
      <div class="section__head">
        <h2 class="h1 section__title">{{ section.settings.heading | default: coll.title | escape }}</h2>
        <a href="{{ coll.url }}" class="link-arrow">Tout voir {% render 'icon', name: 'arrow' %}</a>
      </div>
      <div class="grid">
        {%- for product in coll.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="section">
    <div class="page-width">
      <p class="editor-note">
        Section « {{ section.settings.heading | escape }} » masquée : choisis une collection
        {%- if section.settings.hide_if_single %} contenant au moins 2 produits{% endif %}.
      </p>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Grille de produits",
  "class": "section-collection-grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Tous les squishy" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Nombre de produits", "min": 2, "max": 12, "step": 1, "default": 8 },
    {
      "type": "checkbox",
      "id": "hide_if_single",
      "label": "Masquer tant qu'il n'y a qu'un produit",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "plain", "label": "Fond de page" },
        { "value": "pink", "label": "Rose" },
        { "value": "mint", "label": "Menthe" },
        { "value": "butter", "label": "Vanille" },
        { "value": "lilac", "label": "Lilas" }
      ],
      "default": "plain"
    }
  ],
  "presets": [{ "name": "Grille de produits" }]
}
{% endschema %}
