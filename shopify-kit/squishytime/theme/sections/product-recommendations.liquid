<product-recommendations class="section" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      <h2 class="h1 section__title">{{ section.settings.heading | escape }}</h2>
      <div class="grid">
        {%- for reco in recommendations.products -%}
          {% render 'product-card', product: reco %}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Recommandations",
  "class": "section-recos",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Tu aimeras aussi" },
    { "type": "range", "id": "limit", "label": "Nombre de produits", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Recommandations" }]
}
{% endschema %}
