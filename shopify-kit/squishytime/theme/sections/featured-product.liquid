{%- assign product = section.settings.product -%}
<section class="section section--{{ section.settings.background }}" id="acheter">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="h1 section__title section__title--center">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if product -%}
      <div class="product">
        <div class="product__media">
          {% render 'product-media', product: product, section_id: section.id %}
        </div>
        <div class="product__info">
          {% render 'product-buy', product: product, section_id: section.id, section_settings: section.settings, heading_tag: 'h3' %}
          <a href="{{ product.url }}" class="link-arrow">Voir tous les détails {% render 'icon', name: 'arrow' %}</a>
        </div>
      </div>
    {%- else -%}
      <div class="product">
        <div class="product__media">
          <div class="gallery__placeholder">{% render 'squishy-art', animated: true %}</div>
        </div>
        <div class="product__info">
          <h3 class="h2">Ton squishy ici</h3>
          <p class="muted">Choisis le produit dans Personnaliser → Produit vedette.</p>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Produit vedette",
  "class": "section-featured-product",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre de la section", "default": "Choisis ta taille" },
    { "type": "product", "id": "product", "label": "Produit" },
    { "type": "text", "id": "hook", "label": "Accroche", "default": "Écrase-le, relâche-le… et regarde-le reprendre sa forme tout doucement." },
    { "type": "checkbox", "id": "show_vendor", "label": "Afficher la marque", "default": false },
    { "type": "checkbox", "id": "show_bundle", "label": "Afficher les offres de lot", "default": true },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Afficher les boutons de paiement express", "default": true },
    { "type": "checkbox", "id": "show_age_warning", "label": "Afficher l'avertissement moins de 3 ans", "default": true },
    {
      "type": "richtext",
      "id": "age_warning_text",
      "label": "Texte de l'avertissement",
      "info": "Vide : texte standard « ne convient pas aux enfants de moins de 36 mois »."
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "plain", "label": "Fond de page" },
        { "value": "pink", "label": "Rose" },
        { "value": "mint", "label": "Menthe" },
        { "value": "butter", "label": "Vanille" },
        { "value": "lilac", "label": "Lilas" }
      ],
      "default": "plain"
    }
  ],
  "presets": [{ "name": "Produit vedette" }]
}
{% endschema %}
