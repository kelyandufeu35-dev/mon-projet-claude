<section class="section section--{{ section.settings.background }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="h1 section__title section__title--center">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="benefits" role="list">
      {%- for block in section.blocks -%}
        <li class="benefit benefit--{{ forloop.index | modulo: 4 }}" {{ block.shopify_attributes }}>
          <span class="benefit__icon">{% render 'icon', name: block.settings.icon %}</span>
          <h3 class="h3">{{ block.settings.title | escape }}</h3>
          <p class="muted">{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Points forts",
  "class": "section-benefits",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Pourquoi on l'adore" },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "plain", "label": "Fond de page" },
        { "value": "pink", "label": "Rose" },
        { "value": "mint", "label": "Menthe" },
        { "value": "butter", "label": "Vanille" },
        { "value": "lilac", "label": "Lilas" }
      ],
      "default": "plain"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Point fort",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "clock", "label": "Horloge" },
            { "value": "hand", "label": "Main" },
            { "value": "ruler", "label": "Règle" },
            { "value": "heart", "label": "Cœur" },
            { "value": "sparkle", "label": "Étincelle" },
            { "value": "truck", "label": "Camion" },
            { "value": "return", "label": "Retour" },
            { "value": "lock", "label": "Cadenas" }
          ],
          "default": "heart"
        },
        { "type": "text", "id": "title", "label": "Titre", "default": "Point fort" },
        { "type": "text", "id": "text", "label": "Texte", "default": "Décris ce point fort en une phrase." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Points forts",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "clock", "title": "Remontée lente", "text": "Il reprend sa forme tout doucement après chaque écrasement." } },
        { "type": "benefit", "settings": { "icon": "hand", "title": "Tout moelleux", "text": "Une mousse souple, agréable à malaxer." } },
        { "type": "benefit", "settings": { "icon": "ruler", "title": "Taille géante", "text": "12 cm de haut, à écraser à pleines mains." } },
        { "type": "benefit", "settings": { "icon": "heart", "title": "Comme une vraie", "text": "Rouge vif, petits grains en creux et feuilles vertes : on dirait une vraie fraise." } }
      ]
    }
  ]
}
{% endschema %}
