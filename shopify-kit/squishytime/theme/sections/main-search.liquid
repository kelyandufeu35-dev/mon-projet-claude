<section class="section">
  <div class="page-width">
    <h1 class="h1 section__title">Recherche</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <label for="SearchInput" class="visually-hidden">Rechercher</label>
      <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Un squishy, une couleur…">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="button button--primary" aria-label="Rechercher">{% render 'icon', name: 'search' %}</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <p class="muted">{{ search.results_count }} résultat{% if search.results_count > 1 %}s{% endif %} pour « {{ search.terms | escape }} »</p>
        <div class="grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <article class="card card--text">
                <a class="card__link" href="{{ item.url }}">
                  <h2 class="card__title">{{ item.title | escape }}</h2>
                  <p class="muted">{{ item.content | strip_html | truncatewords: 20 }}</p>
                </a>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pages">{{ paginate | default_pagination: next: 'Suivant', previous: 'Précédent' }}</nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Recherche",
  "settings": []
}
{% endschema %}
