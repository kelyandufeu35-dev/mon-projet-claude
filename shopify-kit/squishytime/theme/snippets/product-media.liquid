{%- comment -%}
  Galerie produit : glissement au doigt sur téléphone, miniatures en dessous.
  Paramètres : product, section_id.
{%- endcomment -%}
{%- assign featured = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
<media-gallery class="gallery" data-section-id="{{ section_id }}">
  {%- if product.media.size > 0 -%}
    <div class="gallery__track" data-track tabindex="0" aria-label="Photos du produit">
      {%- for media in product.media -%}
        <div class="gallery__slide" data-media-id="{{ media.id }}" id="{{ section_id }}-media-{{ media.id }}">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {%- liquid
                if forloop.first
                  assign loading = 'eager'
                  assign priority = 'high'
                else
                  assign loading = 'lazy'
                  assign priority = 'auto'
                endif
              -%}
              {{ media | image_url: width: 1200 | image_tag:
                widths: '360, 540, 720, 960, 1200',
                sizes: '(min-width: 990px) 560px, 100vw',
                loading: loading,
                fetchpriority: priority,
                alt: media.alt | default: product.title
              }}
            {%- when 'video' -%}
              {{ media | video_tag: autoplay: true, loop: true, muted: true, controls: true, playsinline: true, image_size: '1200x' }}
            {%- when 'external_video' -%}
              {{ media | external_video_tag: loading: 'lazy' }}
            {%- else -%}
              {{ media | media_tag }}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if product.media.size > 1 -%}
      <div class="gallery__thumbs" role="list">
        {%- for media in product.media -%}
          <button type="button" class="gallery__thumb{% if media.id == featured.id %} is-active{% endif %}" data-thumb="{{ media.id }}" aria-label="Voir la photo {{ forloop.index }}">
            {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="gallery__placeholder">
      {% render 'squishy-art', animated: true, label: product.title %}
    </div>
  {%- endif -%}
</media-gallery>
