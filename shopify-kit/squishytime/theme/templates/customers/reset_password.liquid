<section class="section">
  <div class="page-width page-width--narrow">
    <div class="card-box">
      <h1 class="h2">Nouveau mot de passe</h1>
      {%- form 'reset_customer_password', class: 'form' -%}
        {%- if form.errors -%}<div class="form__error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field">
          <label for="ResetPassword">Mot de passe</label>
          <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
        </div>
        <div class="field">
          <label for="ResetConfirm">Confirme le mot de passe</label>
          <input id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
        </div>
        <button type="submit" class="button button--primary">Enregistrer</button>
      {%- endform -%}
    </div>
  </div>
</section>
