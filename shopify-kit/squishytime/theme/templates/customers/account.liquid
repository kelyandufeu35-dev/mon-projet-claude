<section class="section">
  <div class="page-width">
    <div class="section__head">
      <h1 class="h1 section__title">Bonjour {{ customer.first_name | escape }}</h1>
      <a href="{{ routes.account_logout_url }}" class="link-arrow">Se déconnecter</a>
    </div>
    <h2 class="h3">Mes commandes</h2>
    {%- paginate customer.orders by 20 -%}
      {%- if customer.orders.size > 0 -%}
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>Commande</th><th>Date</th><th>Paiement</th><th>Envoi</th><th>Total</th></tr></thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                  <td>{{ order.created_at | date: '%d/%m/%Y' }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      {%- else -%}
        <p class="muted">Tu n'as pas encore passé de commande.</p>
      {%- endif -%}
    {%- endpaginate -%}

    <h2 class="h3">Mon adresse</h2>
    {%- if customer.default_address -%}
      <p>{{ customer.default_address | format_address }}</p>
    {%- endif -%}
    <p><a href="{{ routes.account_addresses_url }}" class="link-arrow">Gérer mes adresses ({{ customer.addresses_count }})</a></p>
  </div>
</section>
