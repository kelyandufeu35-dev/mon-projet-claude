{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <title>Carte cadeau {{ shop.name }}</title>
    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="section">
      <div class="page-width page-width--narrow text-center">
        <div class="card-box">
          <p class="eyebrow">{{ shop.name | escape }}</p>
          <h1 class="h1">Ta carte cadeau</h1>
          <p class="display price">{{ gift_card.balance | money }}</p>
          {%- if gift_card.enabled == false or gift_card.expired -%}
            <p class="form__error">Cette carte n'est plus utilisable.</p>
          {%- elsif gift_card.expires_on -%}
            <p class="muted">Valable jusqu'au {{ gift_card.expires_on | date: '%d/%m/%Y' }}</p>
          {%- endif -%}
          <p>Code : <strong>{{ gift_card.code | format_code }}</strong></p>
          <p><a href="{{ shop.url }}" class="button button--primary">Aller à la boutique</a></p>
        </div>
      </div>
    </main>
  </body>
</html>
